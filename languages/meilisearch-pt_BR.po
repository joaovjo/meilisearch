msgid "Network"
msgstr "Rede"

#: admin/class-experimental-features.php:61
msgid "Enable network-related features and configurations for distributed search."
msgstr "Habilita recursos e configurações relacionadas à rede para busca distribuída."

#: admin/class-experimental-features.php:64
msgid "Get Task Documents Route"
msgstr "Rota Obter Documentos de Tarefa"

#: admin/class-experimental-features.php:65
msgid "Enable API route to retrieve documents associated with specific tasks."
msgstr "Habilita rota de API para recuperar documentos associados a tarefas específicas."

#: admin/class-experimental-features.php:68
msgid "Composite Embedders"
msgstr "Embedders Compostos"

#: admin/class-experimental-features.php:69
msgid "Enable support for multiple embedders working together for advanced vector search."
msgstr "Habilita suporte para múltiplos embedders trabalhando juntos para busca vetorial avançada."

#: admin/class-experimental-features.php:72
msgid "Chat Completions"
msgstr "Completações de Chat"

#: admin/class-experimental-features.php:73
msgid "Enable chat completion API for AI-powered conversational search experiences."
msgstr "Habilita API de completação de chat para experiências de busca conversacional com IA."

#: admin/class-experimental-features.php:76
msgid "Multimodal"
msgstr "Multimodal"

#: admin/class-experimental-features.php:77
msgid "Enable multimodal search capabilities for images, text, and other media types."
msgstr "Habilita capacidades de busca multimodal para imagens, texto e outros tipos de mídia."

