#: admin/class-metrics.php:40
#: admin/class-metrics.php:41
msgid "Metrics"
msgstr "Métricas"

#: admin/class-experimental-features.php:45
msgid "Enable Prometheus-compatible metrics endpoint for monitoring search performance and resource usage."
msgstr "Ativar endpoint de métricas compatível com Prometheus para monitorar desempenho de busca e uso de recursos."

#: admin/class-experimental-features.php:48
msgid "Logs Route"
msgstr "Rota de Logs"

#: admin/class-experimental-features.php:49
msgid "Enable API route to access Meilisearch logs directly through the API for debugging and monitoring."
msgstr "Ativar rota da API para acessar logs do Meilisearch diretamente através da API para depuração e monitoramento."

#: admin/class-experimental-features.php:52
msgid "Edit Documents By Function"
msgstr "Editar Documentos por Função"

#: admin/class-experimental-features.php:53
msgid "Enable document editing using custom functions for batch operations and transformations."
msgstr "Ativar edição de documentos usando funções personalizadas para operações em lote e transformações."

#: admin/class-experimental-features.php:56
msgid "Contains Filter"
msgstr "Filtro Contains"

#: admin/class-experimental-features.php:57
msgid "Enable \"contains\" filter operator for partial string matching in search filters."
msgstr "Ativar operador de filtro \"contains\" para correspondência parcial de strings em filtros de busca."

